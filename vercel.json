{
  "rewrites": [
    { "source": "/jobs", "destination": "https://careerops-jobboard-public.vercel.app/jobs" },
    { "source": "/jobs/", "destination": "https://careerops-jobboard-public.vercel.app/jobs/" },
    { "source": "/jobs/:path*", "destination": "https://careerops-jobboard-public.vercel.app/jobs/:path*" }
  ],
  "crons": [
    {
      "path": "/api/cron/whoop-monthly",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/extend-rides",
      "schedule": "0 3 1 * *"
    }
  ]
}
